# ============================================================
# JDI 脈動傳媒 · Cloudflare Pages/Workers _headers
# ============================================================
#
# 規則說明：
#   1. /assets/*      → 圖片、字型、靜態資產：長 cache 1 年 immutable
#   2. /js/*, /css/*  → 有 ?v=xxx 版本查詢字串，改內容時換 v 就會 bust cache
#   3. /*.html        → 短 cache，讓 HTML 隨時可以更新
#   4. /api/*         → 完全不 cache（動態 API）
#
# Cloudflare _headers 語法：
#   路徑一行、header 縮排兩空白、順序 = 「特定 → 通用」
# ============================================================

# ------------ API 動態端點：完全不 cache ------------
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  Access-Control-Allow-Origin: *

# ------------ 靜態資產：長 cache（含 ?v= 版本號） ------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/css/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ------------ AI/Search 抓取用的關鍵檔案（明確 content-type） ------------
# 這些檔案是 AI bot (GPTBot, ClaudeBot, PerplexityBot 等) 抓取用
# 必須明確設定 content-type，避免 SPA fallback 誤判為 HTML route
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

/brand-entities.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

# 注意：
#   /*.png /*.jpg /*.html 等 pattern 會和 /assets/* /js/* 疊加，導致
#   Cache-Control 出現重複值。所以只保留 /assets /js /css /api 這幾條，
#   其他檔案（HTML、favicon、根目錄小圖）維持 Cloudflare 預設。
