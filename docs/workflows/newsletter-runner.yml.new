name: Newsletter Broadcast Runner

# 每 5 分鐘掃一次，若有 scheduled_at 到期的 broadcast 就執行寄送
# 也支援手動觸發
on:
  schedule:
    - cron: '*/5 * * * *'
  workflow_dispatch:

# 避免並發（一次只跑一個）
concurrency:
  group: newsletter-runner
  cancel-in-progress: false

jobs:
  run-due:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger broadcast-run API
        env:
          CRON_SECRET: ${{ secrets.NEWSLETTER_CRON_SECRET }}
          CF_ACCESS_CLIENT_ID: ${{ secrets.CF_ACCESS_CLIENT_ID }}
          CF_ACCESS_CLIENT_SECRET: ${{ secrets.CF_ACCESS_CLIENT_SECRET }}
        run: |
          if [ -z "$CRON_SECRET" ]; then
            echo "❌ NEWSLETTER_CRON_SECRET not set"
            exit 1
          fi

          # 準備 CF Access headers（若有設定）
          CF_HEADERS=()
          if [ -n "$CF_ACCESS_CLIENT_ID" ] && [ -n "$CF_ACCESS_CLIENT_SECRET" ]; then
            CF_HEADERS=(-H "CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID" -H "CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET")
            echo "✓ Using CF Access Service Token"
          else
            echo "⚠️ CF_ACCESS_CLIENT_ID/SECRET not set (若端點被 Access 保護會 302)"
          fi

          # 呼叫 admin-broadcast-run（不帶 broadcast_id → 自動找到期 pending）
          RESPONSE=$(curl -sS -X POST 'https://jdi-pulse.com/api/newsletter/admin-broadcast-run' \
            -H "X-Cron-Secret: $CRON_SECRET" \
            -H 'Content-Type: application/json' \
            "${CF_HEADERS[@]}" \
            -w '\n---HTTP_CODE:%{http_code}' \
            -d '{}')

          HTTP_CODE=$(echo "$RESPONSE" | grep -oE '---HTTP_CODE:[0-9]+' | cut -d: -f2)
          BODY=$(echo "$RESPONSE" | sed 's/---HTTP_CODE:[0-9]*$//')

          echo "HTTP Code: $HTTP_CODE"
          echo "Response body: $BODY"

          # 情境 1: CF Access 擋掉（302 重定向）
          if [ "$HTTP_CODE" = "302" ] || [ "$HTTP_CODE" = "301" ]; then
            echo "⚠️ 被 Cloudflare Access 擋掉。請確認："
            echo "  1. CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET GitHub Secrets 有設"
            echo "  2. Cloudflare Access Application 有加 Service Auth policy 允許此 token"
            exit 0  # graceful skip，不寄錯誤信
          fi

          # 情境 2: 非 200
          if [ "$HTTP_CODE" != "200" ]; then
            echo "❌ HTTP $HTTP_CODE"
            exit 1
          fi

          # 情境 3: 非 JSON
          if ! echo "$BODY" | jq . > /dev/null 2>&1; then
            echo "❌ Response is not valid JSON"
            exit 1
          fi

          OK=$(echo "$BODY" | jq -r '.ok // false')
          if [ "$OK" != "true" ]; then
            MSG=$(echo "$BODY" | jq -r '.message // ""')
            case "$MSG" in
              *"No pending"*|*"no pending"*|*"not_yet_scheduled"*)
                echo "ℹ️ Nothing to do: $MSG"
                exit 0
                ;;
            esac
            echo "❌ Unexpected error: $BODY"
            exit 1
          fi

          RECIPIENTS=$(echo "$BODY" | jq -r '.recipient_count // 0')
          SUCCESS=$(echo "$BODY" | jq -r '.success_count // 0')
          FAILED=$(echo "$BODY" | jq -r '.fail_count // 0')
          STATUS=$(echo "$BODY" | jq -r '.final_status // "unknown"')
          echo "✅ Broadcast executed: recipients=$RECIPIENTS success=$SUCCESS failed=$FAILED status=$STATUS"

          if [ "$STATUS" = "failed" ] || [ "$STATUS" = "partial" ]; then
            FIRST_ERR=$(echo "$BODY" | jq -r '.first_error // "unknown"')
            echo "⚠️ Broadcast had failures. First error: $FIRST_ERR"
          fi
